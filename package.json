{
  "name": "shareguard-cli",
  "version": "0.4.0",
  "description": "Zero-runtime-dependency Node.js CLI and GitHub Action that scans code, staged changes, and files for hard-coded secrets, provider API keys, and PII, with SARIF output for pre-commit hooks and CI.",
  "type": "module",
  "bin": {
    "shareguard": "src/cli.js"
  },
  "scripts": {
    "check": "node scripts/check.js",
    "test": "node test/index.js",
    "docs": "node scripts/generate-docs.js",
    "selfscan": "node src/cli.js . --fail-on low --no-color"
  },
  "keywords": [
    "security",
    "secrets",
    "secret-scanner",
    "secret-scanning",
    "secret-detection",
    "api-key-detection",
    "privacy",
    "pii",
    "cli",
    "scanner",
    "git",
    "github-action",
    "github-code-scanning",
    "sarif",
    "pre-commit",
    "pre-commit-security",
    "staged-changes",
    "credential-detection",
    "privacy-scanner",
    "devsecops",
    "data-loss-prevention",
    "ci-cd",
    "ci-cd-security",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6fmh/shareguard-cli.git"
  },
  "homepage": "https://github.com/6fmh/shareguard-cli#readme",
  "bugs": {
    "url": "https://github.com/6fmh/shareguard-cli/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "docs",
    "action.yml",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ]
}
