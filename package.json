{
  "name": "shareguard-cli",
  "version": "0.2.0",
  "description": "Zero-runtime-dependency Node.js CLI and GitHub Action for secret detection, PII scanning, and pre-commit security.",
  "type": "module",
  "bin": {
    "shareguard": "src/cli.js"
  },
  "scripts": {
    "check": "node --check src/action.js && node --check src/cli.js && node --check src/config.js && node --check src/format.js && node --check src/git.js && node --check src/ignore.js && node --check src/rules.js && node --check src/scanner.js && npm test",
    "test": "node test/index.js"
  },
  "keywords": [
    "security",
    "secrets",
    "secret-scanner",
    "secret-detection",
    "privacy",
    "pii",
    "cli",
    "scanner",
    "git",
    "github-action",
    "github-code-scanning",
    "sarif",
    "pre-commit",
    "pre-commit-security",
    "staged-changes",
    "credential-detection",
    "privacy-scanner",
    "devsecops",
    "data-loss-prevention",
    "ci-cd",
    "ci-cd-security",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6fmh/shareguard-cli.git"
  },
  "homepage": "https://github.com/6fmh/shareguard-cli#readme",
  "bugs": {
    "url": "https://github.com/6fmh/shareguard-cli/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "action.yml",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ]
}
